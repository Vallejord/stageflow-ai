rules_version = '2';

// StageFlow (T5): cada usuario lee y escribe solo lo suyo, bajo usuarios/{su uid}/...
// Todo lo demás queda cerrado. El servidor usa firebase-admin, que no pasa por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
