{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // El motor (lib/motor/) se escribe y se revisa con el tsconfig de la raíz (strict, sin esta regla):
    // la extensión lo importa tal cual, con la misma regla.
    "noUncheckedIndexedAccess": false
  }
}
